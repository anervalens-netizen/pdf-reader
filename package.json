{
  "name": "pdf-reader",
  "version": "1.2.0",
  "description": "PDF — a calm, fast PDF reader for desktop",
  "main": "./out/main/index.js",
  "author": {
    "name": "Andrei Stancu",
    "email": "anervalens-netizen@users.noreply.github.com"
  },
  "desktopName": "pdf-reader",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "icons": "electron scripts/render-logo.cjs",
    "build:web": "vite build --config vite.web.config.ts",
    "dev:web": "vite --config vite.web.config.ts",
    "preview:web": "vite preview --config vite.web.config.ts",
    "android:sync": "npm run build:web && cap sync android",
    "android:open": "cap open android",
    "pack:win": "npm run build && electron-builder --win --dir --config electron-builder.yml",
    "dist:win": "npm run build && electron-builder --win nsis --publish never --config electron-builder.yml",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb --publish never --config electron-builder.yml",
    "test:edit": "node scripts/test-edit-history.mjs",
    "test:ai": "node scripts/test-ai-history.mjs",
    "test:encrypted": "electron scripts/qa-encrypted-print.cjs",
    "test:text": "node scripts/test-text-export.mjs",
    "test:export": "node scripts/make-sample-pdf.mjs && node scripts/test-export.mjs",
    "test:sw": "node scripts/test-sw.cjs",
    "test:pages": "node scripts/test-page-tools.mjs",
    "test:mobile": "electron scripts/qa-mobile.cjs",
    "test:web": "node scripts/make-sample-pdf.mjs && npm run build:web && electron scripts/qa-web.cjs"
  },
  "dependencies": {
    "@expo-google-fonts/noto-sans": "^0.4.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "electron-updater": "6.8.11",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "typescript": "^7.0.2",
    "vite": "8.3.5"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
